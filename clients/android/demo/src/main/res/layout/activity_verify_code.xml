<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/verify_code_container_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0B0F">

    <!-- Top bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/verify_code_topbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back button -->
        <ImageView
            android:id="@+id/verify_code_container_33"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:background="@drawable/bg_icon_btn"
            android:padding="6dp"
            android:scaleType="centerInside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Step indicator -->
        <TextView
            android:id="@+id/verify_code_text_step"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STEP 02 / 02"
            android:textSize="11sp"
            android:textColor="#61F5F7FA"
            android:letterSpacing="0.2"
            android:fontFamily="monospace"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Spacer to balance back button -->
        <View
            android:id="@+id/verify_code_topbar_spacer"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Heading section -->
    <LinearLayout
        android:id="@+id/verify_code_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="35dp"
        app:layout_constraintTop_toBottomOf="@+id/verify_code_topbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/verify_code_text_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="输入验证码"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#F5F7FA"
            android:letterSpacing="-0.02" />

        <TextView
            android:id="@+id/verify_code_text_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="已发送至 +86 138 **** 8000"
            android:textSize="14sp"
            android:textColor="#99F5F7FA" />

    </LinearLayout>

    <!-- Form section -->
    <LinearLayout
        android:id="@+id/verify_code_form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="29dp"
        app:layout_constraintTop_toBottomOf="@+id/verify_code_hero"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Code input row (6 boxes) -->
        <LinearLayout
            android:id="@+id/verify_code_container_39"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:weightSum="6">

            <FrameLayout
                android:id="@+id/verify_code_container_40"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_code_box_filled">

                <TextView
                    android:id="@+id/verify_code_digit_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="2"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#F5F7FA"
                    android:fontFamily="monospace" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/verify_code_container_41"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_code_box_filled">

                <TextView
                    android:id="@+id/verify_code_digit_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="4"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#F5F7FA"
                    android:fontFamily="monospace" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/verify_code_container_42"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_code_box_filled">

                <TextView
                    android:id="@+id/verify_code_digit_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="8"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#F5F7FA"
                    android:fontFamily="monospace" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/verify_code_container_43"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_code_box_filled">

                <TextView
                    android:id="@+id/verify_code_digit_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="1"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#F5F7FA"
                    android:fontFamily="monospace" />
            </FrameLayout>

            <!-- Current box with caret -->
            <FrameLayout
                android:id="@+id/verify_code_container_44"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_code_box_current">

                <View
                    android:id="@+id/verify_code_container_45"
                    android:layout_width="2dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:background="#5EB5C8" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/verify_code_container_46"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_code_box" />

        </LinearLayout>

        <!-- Resend row -->
        <LinearLayout
            android:id="@+id/verify_code_resend_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <TextView
                android:id="@+id/verify_code_text_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="未收到验证码?"
                android:textSize="12sp"
                android:textColor="#99F5F7FA"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/verify_code_container_48"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="42s 后重发"
                android:textSize="12sp"
                android:textColor="#61F5F7FA" />

        </LinearLayout>

        <!-- Submit button -->
        <FrameLayout
            android:id="@+id/verify_code_container_49"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="29dp"
            android:background="@drawable/bg_btn_primary_disabled">

            <TextView
                android:id="@+id/verify_code_container_50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="确认登录"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#61001015"
                android:letterSpacing="0.01" />

        </FrameLayout>

        <!-- Agreement row -->
        <LinearLayout
            android:id="@+id/verify_code_agreement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/verify_code_container_52"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="1dp"
                android:src="@drawable/ic_container_52"
                android:background="@drawable/bg_checkbox_checked"
                android:scaleType="centerInside"
                android:padding="2dp" />

            <TextView
                android:id="@+id/verify_code_container_55"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="已阅读并同意 服务条款 与 隐私政策"
                android:textSize="11sp"
                android:textColor="#99F5F7FA" />

        </LinearLayout>

    </LinearLayout>

    <!-- Home indicator -->
    <LinearLayout
        android:id="@+id/verify_code_container_56"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="vertical"
        android:gravity="bottom|center_horizontal"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:id="@+id/verify_code_container_57"
            android:layout_width="134dp"
            android:layout_height="5dp"
            android:background="@drawable/bg_home_bar" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
